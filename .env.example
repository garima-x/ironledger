# IronLedger — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is already in .gitignore and will NEVER be committed.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Your Project → Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# ── Optional: Ethereum Sepolia ────────────────────────────────────────────────
# Contract address is already hard-coded in blockchain.py; override here if needed.
# SEPOLIA_CONTRACT_ADDRESS=0x7a36B3DeE1F03287cCE488f2604245F11dF9d78F
