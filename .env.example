# IronLedger — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will NEVER be committed to version control.

# ── 1. Database (Optional: Supabase Persistence) ──────────────────────────────
# If not set, IronLedger automatically runs in fast in-memory session mode.
# Get these from: https://app.supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# ── 2. Blockchain (Optional: Live Ethereum Sepolia Anchoring) ───────────────────
# If omitted or unconfigured, IronLedger automatically runs in local cryptographic simulation mode.
# Never use a wallet with mainnet funds! Use a dedicated testnet wallet.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
SEPOLIA_CONTRACT_ADDRESS=0x7a36B3DeE1F03287cCE488f2604245F11dF9d78F
ANCHOR_PRIVATE_KEY=0x_your_throwaway_sepolia_testnet_private_key_here

# ── 3. Security & Operational Modes ──────────────────────────────────────────
# Optional API Key for authenticating write/command endpoints via 'X-API-Key' header.
# API_KEY=your-secure-api-key-here

# Set to 'true' to allow interactive attack injection & tamper testing in the UI.
DEMO_MODE=true

# Server Host & Port
HOST=127.0.0.1
PORT=8080
